#!/usr/bin/env bash
# Runs MutRoSe inside a native-arch Linux container, built from
# tools/mutrose/Dockerfile. Use this if build-macos.sh produces empty
# decompositions on your inputs.
#
# Usage: tools/mutrose/mutrose-docker <hddl-file> <gm-file> <config-file> [options...]
# (run from the directory containing your hddl/gm/configuration/knowledge folders)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="mutrose:arm64"

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "==> Building $IMAGE (first use only)" >&2
  docker build -t "$IMAGE" "$SCRIPT_DIR"
fi

docker run --rm -v "$PWD":/w -w /w "$IMAGE" mutrose "$@"
