// A launch configuration that builds the webview and the extension host, then opens the
// extension inside a new window on the src/test sample workspace.
{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "Launch Client",
      "runtimeExecutable": "${execPath}",
      "args": [
        "${workspaceRoot}/src/test",
        "--extensionDevelopmentPath=${workspaceRoot}"
      ],
      "timeout": 30000,
      "preLaunchTask": {
        "type": "npm",
        "script": "compile:dev"
      }
    }
  ]
}
