          "x": 711.4577836411609,
          "y": 488.52770448548813,
          "customProperties": {
            "Description": "",
            "GoalType": "Achieve",
            "Controls": "current_room : Room",
            "Monitors": "rooms",
            "AchieveCondition": "rooms->forAll(current_room | current_room.is_clean)"
          }
        },
        {
