          "x": 297.95778364116086,
          "y": 496.52770448548813,
          "customProperties": {
            "Description": "",
            "GoalType": "Query",
            "Controls": "rooms : Sequence(Room)",
            "QueriedProperty": "world_db->select(r:Room | !r.is_clean)"
          }
        },
        {
          "id": "a07c4186-f533-4a0a-afbe-6efcb81222f6",
          "text": "G3: Clean Rooms",
