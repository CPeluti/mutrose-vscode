{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2024",
    "lib": [
      "es2024"
    ],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "composite": true,
    "types": [
      "node",
      "mocha"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./src/plugins/lsp/lsp-mutrose"
    }
  ],
  "exclude": [
    "src/plugins/lsp/lsp-mutrose",
    "src/plugins/editor",
    "src/editors",
    "node_modules",
    ".vscode-test"
  ]
}